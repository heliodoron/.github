# Private material: never committed. The shared checks also refuse it.
**/_private/*
!**/_private/.gitkeep

# Secrets
.env
.env.*
!.env.example
!.env.sample
!.env.template
*.pem
*.key

# Terraform state and real variable files
*.tfstate
*.tfstate.*
*.tfvars
*.tfvars.json
.terraform/

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Node
node_modules/
dist/

# OS and editor
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/

# Tool scratch
.playwright-mcp/
